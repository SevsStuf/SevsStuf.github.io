---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const { title } = Astro.props;
---
<html lang="en">
    <style>
        
    html {
        margin: 0;
        padding: 0;
    }

    body {
        background: repeating-conic-gradient(#130A1E 0 25%, #0E0816 0 50%) 30% / 300px 300px;
        background-color: #0B0A19;
        background-attachment: fixed;
        color: white;
        font-family: "Itim";
  
        font-size: 1vw; /* Browsers that do not support the "min()", "max()", and "clamp()" functions will take this value. */
        font-size: max(20px, min(1vw, 150px)); /* Browsers that do not support the "clamp()" function will take this value. */
        font-size: clamp(20px, 1vw, 150px);
  
        margin: 0;
  
        animation: 20s linear background-shift infinite;
        -webkit-animation: 20s linear background-shift infinite;

        width: 100%;

        height: 100vh;

        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    @keyframes background-shift {

        from {
            background-position: 0px 0px
        }
        to {
            background-position: 300px 300px
        }
    }

    #flex {
        display: flex;
    }

    </style>
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>Sevs Stuf - {title}</title>
    </head>
    <body>
        <Header/>
        <slot />
        <Footer/>
    </body>
</html>