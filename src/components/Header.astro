---
const BlueskyLink = "https://bsky.app/profile/sevsstuf.bsky.social"
const TwitterLink = "https://x.com/sevrgpro"
const DiscordLink = "https://discord.gg/N7y2wt7P3m"
const TwitchLink = "https://www.twitch.tv/sevsstuf"
const YoutubeLink = "https://www.youtube.com/@Sevrgpro"
const GithubLink = "https://github.com/SevsStuf/"
---


<header>
    <nav id="header-left">
        <nav id="nav-buttons">
            <a href="/"><img src="/HomeButton.png" class="nav-button"></a>
            <a href="/"><img src="/BioButton.png" class="nav-button"></a>
            <a href="/"><img src="/PortfolioButton.png" class="nav-button"></a>
            <a href="/"><img src="/BlogButton.png" class="nav-button"></a>
            <a href="/"><img src="/ReviewsButton.png" class="nav-button"></a>
        </nav>
        <img src="/HeaderLeft.png" id="left-image">
    </nav>

    <img id="header-center" src="/HeaderCenter.png">
      
    <div id="header-right">
        <div id="socials-text">My socials:</div>
        <nav id="socials">
            <a href={BlueskyLink}><img src="/BlueskyButton.png" class="social-button-image"></a>
            <a href={TwitterLink}><img src="/TwitterButton.png" class="social-button-image"></a>
            <a href={DiscordLink}><img src="/DiscordButton.png" class="social-button-image"></a>
            <a href={TwitchLink}><img src="/TwitchButton.png" class="social-button-image"></a>
            <a href={YoutubeLink}><img src="/YoutubeButton.png"} class="social-button-image"></a>
            <a href={GithubLink}><img src="/GithubButton.png" class="social-button-image"></a>
        </nav>
        <img id="right-image" src="/HeaderRight.png">
    </div>
</header>

<style>
    header {
        display: flex;
    }



    #nav-buttons {
        display: flex;
        justify-content: left;
        position: absolute;
        padding-top: 7px;
        padding-left: 11px;
        gap: 19.3px;
    }



    #header-center {
        width: 0px;
        flex-grow: 1;
    }


    img {
        display: block;
    }

    #socials {
        position: absolute;
        display: flex;
        justify-content: left;
        margin-top: 9px;
        margin-left: 26px;
        gap: 15px;
    }
    #socials-text {
        position: absolute;
        right: 320px;
        margin-top: 5px;
        font-size: 30px;
    }
</style>