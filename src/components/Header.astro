---
import { Image } from 'astro:assets';
import headerLeft from '../assets/HeaderLeft.png';
---


<header>
    <nav id="header-left">
        <nav id="nav-buttons">
            <a href="/"><img class="nav-button" src="src/assets/HomeButton.png"></a>
            <a href="/"><img class="nav-button" src="src/assets/BioButton.png"></a>
            <a href="/"><img class="nav-button" src="src/assets/PortfolioButton.png"></a>
            <a href="/"><img class="nav-button" src="src/assets/BlogButton.png"></a>
            <a href="/"><img class="nav-button" src="src/assets/ReviewsButton.png"></a>
        </nav>
        <Image src={headerLeft} alt="" id="left-image" />
    </nav>

    <img id="header-center" src="src/assets/HeaderCenter.png">
      
    <div id="header-right">
        <div id="socials-text">My socials:</div>
        <nav id="socials">
            <a href="https://bsky.app/profile/sevsstuf.bsky.social"><img class="social-image" src="/src/assets/BlueskyButton.png"></a>
            <a href="https://x.com/sevrgpro"><img class="social-button-image" src="src/assets/TwitterButton.png"></a>
            <a href="https://discord.gg/N7y2wt7P3m"><img class="social-button-image" src="src/assets/DiscordButton.png"></a>
            <a href="https://www.twitch.tv/sevsstuf"><img class="social-button-image" src="src/assets/TwitchButton.png"></a>
            <a href="https://www.youtube.com/@Sevrgpro"><img class="social-button-image" src="src/assets/YoutubeButton.png"></a>
            <a href="https://github.com/SevsStuf/"><img class="social-button-image" src="src/assets/GithubButton.png"></a>
        </nav>
        <img id="right-image" src="src/assets/HeaderRight.png">
    </div>
</header>

<style>
    header {
        display: flex;
        height: 74px;
        max-width: 100vw;
    }



    #nav-buttons {
        display: flex;
        justify-content: left;
        position: absolute;
        padding-top: 7px;
        padding-left: 11px;
        gap: 19.3px;
    }
    .nav-button {
        display: block;
    }
    #left-image {
        display: block;
    }



    #header-center {
        width: 0px;
        flex-grow: 1;
    }




    #socials {
        position: absolute;
        display: flex;
        justify-content: left;
        margin-top: 9px;
        margin-left: 26px;
        gap: 15px;
    }
    #socials-text {
        position: absolute;
        right: 320px;
        margin-top: 5px;
        font-size: 30px;
    }
    .social-button-image {
        display: block;
    }
    #right-image {
        display: block;
    }
</style>