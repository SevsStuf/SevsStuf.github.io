---
import { Image } from 'astro:assets';

import HomeButton from "../assets/HomeButton.png";
import BioButton from "../assets/BioButton.png";
import PortfolioButton from "../assets/PortfolioButton.png";
import BlogButton from "../assets/BlogButton.png";
import ReviewsButton from "../assets/ReviewsButton.png";

import HeaderLeft from "../assets/HeaderLeft.png";
import HeaderCenter from "../assets/HeaderCenter.png";
import HeaderRight from "../assets/HeaderRight.png";

import BlueskyButton from "../assets/BlueskyButton.png";
import TwitterButton from "../assets/TwitterButton.png";
import DiscordButton from "../assets/DiscordButton.png";
import TwitchButton from "../assets/TwitchButton.png";
import YoutubeButton from "../assets/YoutubeButton.png";
import GithubButton from "../assets/GithubButton.png";
---


<header>
    <nav id="header-left">
        <nav id="nav-buttons">
            <a href="/"><Image src={HomeButton} class="nav-button" alt="" /></a>
            <a href="/"><Image src={BioButton} class="nav-button" alt="" /></a>
            <a href="/"><Image src={PortfolioButton} class="nav-button" alt="" /></a>
            <a href="/"><Image src={BlogButton} class="nav-button" alt="" /></a>
            <a href="/"><Image src={ReviewsButton} class="nav-button" alt="" /></a>
        </nav>
        <Image src={HeaderLeft} alt="" id="left-image" />
    </nav>

    <Image alt="" id="header-center" src={HeaderCenter} />
      
    <div id="header-right">
        <div id="socials-text">My socials:</div>
        <nav id="socials">
            <a href="https://bsky.app/profile/sevsstuf.bsky.social"><Image src={BlueskyButton} class="social-button-image" alt="" /></a>
            <a href="https://x.com/sevrgpro"><Image src={TwitterButton} class="social-button-image" alt="" /></a>
            <a href="https://discord.gg/N7y2wt7P3m"><Image src={DiscordButton} class="social-button-image" alt="" /></a>
            <a href="https://www.twitch.tv/sevsstuf"><Image src={TwitchButton} class="social-button-image" alt="" /></a>
            <a href="https://www.youtube.com/@Sevrgpro"><Image src={YoutubeButton} class="social-button-image" alt="" /></a>
            <a href="https://github.com/SevsStuf/"><Image src={GithubButton} class="social-button-image" alt="" /></a>
        </nav>
        <Image alt="" id="right-image" src={HeaderRight} />
    </div>
</header>

<style>
    header {
        display: flex;
        height: 74px;
        max-width: 100vw;
    }



    #nav-buttons {
        display: flex;
        justify-content: left;
        position: absolute;
        padding-top: 7px;
        padding-left: 11px;
        gap: 19.3px;
    }
    .nav-button {
        display: block;
    }
    #left-image {
        display: block;
    }



    #header-center {
        width: 0px;
        flex-grow: 1;
    }




    #socials {
        position: absolute;
        display: flex;
        justify-content: left;
        margin-top: 9px;
        margin-left: 26px;
        gap: 15px;
    }
    #socials-text {
        position: absolute;
        right: 320px;
        margin-top: 5px;
        font-size: 30px;
    }
    .social-button-image {
        display: block;
    }
    #right-image {
        display: block;
    }
</style>